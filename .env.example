# ==============================================================
#  error-fare-hunter – wzór konfiguracji
#  Skopiuj do .env (lokalnie) LUB wpisz jako GitHub Secrets.
#  Puste pole = dane źródło jest pomijane.
# ==============================================================

# --- Ogólne ---------------------------------------------------
DRY_RUN=0                      # 1 = tylko loguj, nie wysyłaj maili
LOG_LEVEL=INFO                 # DEBUG, INFO, WARNING
HOME_AIRPORTS=WAW,WMI,KRK,GDN,KTW,WRO,POZ,RZE,LUZ,SZZ,BZG,LCJ,BER

# --- Progi cenowe (PLN) --------------------------------------
MAX_PRICE_EUROPE_PLN=60        # lot po Europie w obie strony poniżej tej kwoty = okazja
MAX_PRICE_LONGHAUL_PLN=1000    # daleki dystans poniżej tej kwoty = okazja
PRICE_DROP_RATIO=0.5           # cena < 50% mediany historycznej trasy = okazja
MIN_HISTORY_SAMPLES=5          # ile obserwacji potrzeba, by ufać medianie
EUR_PLN=4.3
USD_PLN=3.9
GBP_PLN=5.0

# --- API lotnicze (wystarczy jedno) --------------------------
KIWI_API_KEY=                  # https://tequila.kiwi.com (partnerzy)
SERPAPI_KEY=                   # https://serpapi.com – 100 zapytań/mies. za darmo
DUFFEL_ACCESS_TOKEN=           # https://app.duffel.com – token testowy
API_DESTINATIONS=BCN,LIS,ROM,LON,PAR,MAD,ATH,NYC,BKK,TYO,DXB
API_DAYS_AHEAD=90

# --- Telegram (https://my.telegram.org -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=              # wygeneruj: python -m scrapers.telegram_scraper --login
TELEGRAM_CHANNELS=fly4free,lowcymamutow,pepperpl,loterpl
TELEGRAM_LOOKBACK_MINUTES=60   # przy 1. uruchomieniu czytaj posty z ostatnich N minut

# --- WWW / Facebook ------------------------------------------
RSS_FEEDS=https://www.fly4free.pl/feed/,https://loter.pl/feed/,https://www.pepper.pl/rss/grupa/podroze
ENABLE_AIRLINE_PAGES=1
ENABLE_FACEBOOK=0              # 1 = włącz (wymaga playwright + często blokowane)
FACEBOOK_PAGES=fly4free,lowcymamutow

# --- E-mail: SMTP (Gmail: włącz 2FA i utwórz „hasło aplikacji”) --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=twoj.mail@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=twoj.mail@gmail.com
EMAIL_TO=twoj.mail@gmail.com   # kilka adresów rozdziel przecinkiem

# --- E-mail: alternatywnie SendGrid (100 maili/dzień za darmo) --
SENDGRID_API_KEY=
